# Non-secret configuration template. Copy to .env for local testing.
# Never commit real API keys, credentials, or family/student data.

GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Strategic Model Routing (override without rebuilding)
PATHFINDER_FLASH_MODEL=gemini-3.8-flash
PATHFINDER_PRO_MODEL=gemini-3.1-pro

# Optional: For Google AI Studio local testing instead of Vertex AI, store key in Secret Manager
# or set GEMINI_API_KEY_SECRET_NAME (never hardcode keys in source files).
GEMINI_API_KEY_SECRET_NAME=pathfinder-gemini-api-key

# Persistence (defaults to local SQLite for dev; use Cloud SQL postgresql+asyncpg:// in prod)
SESSION_DB_URL=sqlite+aiosqlite:///./pathfinder_sessions.db
MEMORY_BACKEND=local

# Privacy & Observability
ENABLE_CLOUD_DLP=false
ENABLE_CLOUD_TRACE=false
CAPTURE_MESSAGE_CONTENT=false
LOG_LEVEL=INFO
